# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local file-backed store (dev only, no live Supabase)
/data/*.json
/data/private-slips/**
/public/uploads/**

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local/generated
.next/
node_modules/
tsconfig.tsbuildinfo
.cx-check-out.txt
.env
.env.local
.env.*.local
