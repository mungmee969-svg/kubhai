# KubHai local / staging environment
# Never point this file at production. Do not commit real secrets.

# Leave empty to use the local file-backed store (data/local-dev.json).
# When both are set, the app uses Supabase instead of the local store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session signing for local-dev auth. Replace before any shared staging deploy.
KUBHAI_SESSION_SECRET=local-dev-only-change-me

# Google Maps Platform (optional).
# Server keys: restrict by server IP/service account and enable only the named APIs.
# Browser key: restrict by production HTTP referrers and Maps Embed API.
# Never reuse the browser key for server Places/Routes calls.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
# Optional Mapbox token (detection only; Places still use Google or local catalog)
NEXT_PUBLIC_MAPBOX_TOKEN=

# KubHai SaaS receiving account (Store → KubHai only; never customer booking money).
# Leave all empty to show a truthful unavailable state.
KUBHAI_SAAS_PROMPTPAY_ID=
KUBHAI_SAAS_PROMPTPAY_QR_URL=
KUBHAI_SAAS_BANK_NAME=
KUBHAI_SAAS_BANK_ACCOUNT_NAME=
KUBHAI_SAAS_BANK_ACCOUNT_NUMBER=
