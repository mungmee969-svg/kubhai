# KubHai local / staging environment
# Never point this file at production. Do not commit real secrets.

# Leave empty to use the local file-backed store (data/local-dev.json).
# When both are set, the app uses Supabase instead of the local store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session signing for local-dev auth. Replace before any shared staging deploy.
KUBHAI_SESSION_SECRET=local-dev-only-change-me

# Google Maps / Places (optional). Prefer server key; NEXT_PUBLIC is fallback for client detection.
# Enable: Places API (New) — Autocomplete + Place Details.
# Restrict by HTTP referrer (browser) and/or IP (server). Never commit real keys.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Mapbox token (detection only; Places still use Google or local catalog)
NEXT_PUBLIC_MAPBOX_TOKEN=
